# ==========================================================================
# Apache configuration for production hosting.
# (Ignored by `php -S`, which is only a development server.)
# ==========================================================================

# Compress text responses.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/vtt application/javascript image/svg+xml
</IfModule>

# Long cache for media. HTML and PHP responses are not cached.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml          "access plus 1 month"
    ExpiresByType image/jpeg             "access plus 1 month"
    ExpiresByType image/webp             "access plus 1 month"
    ExpiresByType text/vtt               "access plus 1 month"
    ExpiresByType video/mp4              "access plus 1 month"
    ExpiresByType video/webm             "access plus 1 month"
</IfModule>

# JavaScript: the browser may keep a copy but must check it with the server
# (ETag, usually a tiny 304) before using it. Module URLs have no version
# in them, so a long cache would keep old code after a deploy.
<IfModule mod_headers.c>
    <FilesMatch "\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Correct MIME types for captions and modules.
AddType text/vtt .vtt
AddType application/javascript .js

# No directory listings.
Options -Indexes
